# (Optional) Gemini API Key for live AI Agent SDK execution
# If not provided, agents will fall back to Antigravity CLI ('agy') or smart contextual local simulation.
GEMINI_API_KEY=

# (Optional) Custom Antigravity Skills directory path
# AGY_SKILLS_DIR=

# (Optional) Path to Antigravity CLI executable ('agy' or 'agy.cmd' or 'agy.exe')
# If not set, it will auto-detect from PATH or standard install locations.
# AGY_PATH=

