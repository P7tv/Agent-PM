# ==========================================
# Antigravity Virtual AI Office Environment
# ==========================================

# (Optional) Gemini API Key for live AI Agent SDK execution
# Requires a separately installed, compatible SDK. Otherwise the installed agy CLI is used.
# A missing or failing runtime returns an error; production never falls back to simulation.
GEMINI_API_KEY=

# (Optional) Custom Antigravity Skills directory path
# AGY_SKILLS_DIR=

# (Optional) Path to Antigravity CLI executable ('agy' or 'agy.cmd' or 'agy.exe')
# If not set, it will auto-detect from PATH or standard install locations.
# AGY_PATH=

# Agent quality and execution limits
AGENT_EFFORT=high
AGENT_TIMEOUT_SECONDS=600
TEST_TIMEOUT_SECONDS=120

# Optional isolated database for development / QA
# PM_STATE_DB=/absolute/path/to/state.db
